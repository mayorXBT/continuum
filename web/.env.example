# Contract addresses on Monad testnet. Copy this file to .env.local and fill in
# after running script/Deploy.s.sol. Until set, the app runs in pre-deploy mode.
NEXT_PUBLIC_APASS=
NEXT_PUBLIC_STMON=
NEXT_PUBLIC_VAULT=
NEXT_PUBLIC_QUEUE=
NEXT_PUBLIC_ROUTER=

# ————— Cleanverse sandbox —————
# Server-only. api-id goes in request headers; api-key is used locally to
# AES-encrypt request bodies and must never be transmitted or exposed.
CLEANVERSE_API_ID=
CLEANVERSE_API_KEY=
CLEANVERSE_BASE_URL=https://uatapi.cleanverse.com/api/cooperate
CLEANVERSE_CHAIN=monad

# ————— Demo access (optional) —————
# Lets a visitor issue themselves a testnet credential from the Verify panel.
# Leave DEMO_ONBOARDING empty to disable the route entirely.
#
# OPERATOR_PRIVATE_KEY must be the registry's `operator` (set via
# setOperator), NOT the owner. That role can only call verify() — it cannot
# revoke, cannot change the compliance mode, and cannot touch the vault. Fund it
# with a small amount of gas and nothing else; if it leaks, the damage is a
# polluted registry rather than the protocol.
#
# CHALLENGE_SECRET signs the wallet-ownership challenge tokens. Any long random
# string. Falls back to OPERATOR_PRIVATE_KEY if unset.
#
# DEMO_ONBOARDING_MAX is a hard ceiling on credentials issued per process.
DEMO_ONBOARDING=
DEMO_ONBOARDING_MAX=250
OPERATOR_PRIVATE_KEY=
CHALLENGE_SECRET=
